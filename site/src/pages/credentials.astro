---
import Base from '../layouts/Base.astro';
import { href } from '../lib/paths';
import CTABand from '../components/CTABand.astro';

// Each tile's last line swaps to a real certificate download link as the
// owner supplies documents — see site/README.md.
const tiles = [
  ['7 GB', 'CIDB GRADING', 'Registered with the Construction Industry Development Board at grade 7 GB — qualifying us for general building contracts in the top regional tier.', 'Certificate available on request'],
  ['Level 4', 'B-BBEE CONTRIBUTOR', 'BEE Level 4 rating, backed by a working SMME subcontractor development programme — not a scorecard exercise.', 'Certificate available on request'],
  ['ECMBA', 'MASTER BUILDERS ASSOCIATION', 'Member of the Master Builders Association, Eastern Cape — with the health & safety and workmanship standards membership requires.', 'Membership confirmation on request'],
  ['ISO 9001', 'REGISTRATION IN PROGRESS', 'Formal ISO-9001 registration is underway, building on the total quality management approach we already run on every project.', 'Status updated on completion'],
  ['1993', '33 YEARS TRADING', 'Smart and Botha Construction CC t/a Techni Construction — trading continuously in Nelson Mandela Bay since 1993, fully registered with the pertinent building authorities.', 'Company registration on request'],
  ['R200 M', 'PROJECT CAPACITY', 'Resourced for projects up to R200 million: 50+ site employees, 6 site managers, and established SMME subcontractor capacity for specialised works.', 'Insurances available on request'],
];
---

<Base
  title="Credentials — CIDB 7 GB, BEE Level 4, ECMBA | Techni Construction"
  description="Everything needed to shortlist Techni Construction: CIDB 7 GB grading, BEE Level 4, ECMBA membership, ISO-9001 in progress — verifiable and in one place."
>
  <section aria-label="Intro" class="wrap intro">
    <div class="intro-row">
      <div>
        <div class="kicker">For architects, QSs &amp; developers</div>
        <h1 class="display" style="max-width:18ch">Everything you need to shortlist us.</h1>
        <p class="lede" style="margin-top:16px;max-width:58ch">
          Registrations, ratings and memberships — verifiable, current, and in
          one place. Certificates download directly where available.
        </p>
      </div>
      <a href={href('/contact/')} class="btn btn-brick profile-btn">Request the company profile</a>
    </div>
  </section>

  <section aria-label="Credentials" class="wrap tiles-outer">
    <div class="stat-grid tiles">
      {tiles.map(([n, label, copy, avail]) => (
        <div class="tile">
          <div class="tile-n">{n}</div>
          <div class="tile-label">{label}</div>
          <p>{copy}</p>
          <div class="tile-avail">{avail}</div>
        </div>
      ))}
    </div>
  </section>

  <section aria-label="Health and safety" class="hs-band">
    <div class="wrap hs-inner">
      <h2 class="section" style="font-size:clamp(28px,3vw,40px)">Health &amp; safety is a delivery value, not a poster.</h2>
      <div>
        <p class="body-copy">
          A safe workplace for every worker and visitor on our sites is the
          first commitment in our mission — ahead of programme and ahead of
          margin. Site management runs to MBA health &amp; safety standards on
          all projects.
        </p>
        <p class="body-copy" style="margin-bottom:0">
          Safety files, appointments and project-specific H&amp;S plans are
          prepared per contract and are open to client and consultant audit at
          any time.
        </p>
      </div>
    </div>
  </section>

  <CTABand heading="Need a certificate or a reference for a tender?">
    <a href={href('/contact/')} class="btn btn-white-on-brick">Email the office</a>
  </CTABand>
</Base>

<style>
  .intro { padding-top: 72px; padding-bottom: 56px; }
  .intro-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; }
  .profile-btn { flex: none; padding: 16px 30px; }
  .tiles-outer { padding-bottom: 64px; }
  .tiles { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .tile { padding: 38px 32px; }
  .tile-n { font: 900 46px var(--font-display); letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .tile-label { font: 600 13px var(--font-mono); letter-spacing: .1em; color: var(--brick); margin: 8px 0 14px; }
  .tile p { font: 400 14.5px/1.65 var(--font-display); color: var(--body-2); margin: 0; }
  .tile-avail { font: 500 12.5px var(--font-mono); color: var(--meta-faint); margin-top: 16px; }
  .hs-band { background: var(--card); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .hs-inner {
    padding-top: 80px; padding-bottom: 80px;
    display: grid; grid-template-columns: 1fr 1.4fr; gap: 64px; align-items: start;
  }
  .hs-inner h2 { margin: 0; }
  @media (max-width: 900px) { .hs-inner { grid-template-columns: 1fr; gap: 32px; } }
</style>
