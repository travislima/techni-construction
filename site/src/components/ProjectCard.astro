---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { href } from '../lib/paths';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const p = project.data;
const tag = [p.sector, p.location].filter(Boolean).join(' · ');
const meta = [p.size, p.value, p.year].filter(Boolean).join(' · ');
const detailUrl = p.caseStudy ? href(`/projects/${project.id}/`) : undefined;
---

<div class="pcard" data-sector={p.sector}>
  {detailUrl ? (
    <a href={detailUrl} class="imglink" aria-label={`${p.name} — view case study`}>
      <div class="pcard-imgbox">
        <Image src={p.thumb} alt={p.alt} widths={[420, 640, 900]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 400px" loading="lazy" class="pimg" />
      </div>
    </a>
  ) : (
    <div class="pcard-imgbox">
      <Image src={p.thumb} alt={p.alt} widths={[420, 640, 900]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 400px" loading="lazy" class="pimg" />
    </div>
  )}
  <div class="pcard-tag">{tag}</div>
  <div class="pcard-name">{p.name}</div>
  {meta && <div class="pcard-meta">{meta}</div>}
  {detailUrl && (
    <a href={detailUrl} class="detail-link">View case study →</a>
  )}
</div>

<style>
  .imglink { display: block; }
  .pimg { width: 100%; aspect-ratio: 4/3; object-fit: cover; height: auto; }
  .detail-link {
    font: 600 13.5px var(--font-display);
    color: var(--brick);
    text-decoration: none;
    margin-top: 10px;
    align-self: flex-start;
  }
  .detail-link:hover { color: var(--brick-hover); }
</style>
